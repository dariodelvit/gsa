<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Grupo Scout ACRUX 518 de Valladolid. Educando en valores, naturaleza y tiempo libre desde 1977. Perteneciente a ASDE Exploradores de Castilla y León.">
    <title>Grupo Scout ACRUX 518 | Valladolid · Aprender Jugando</title>
    <link rel="icon" type="image/svg+xml" href="images/logo.svg">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <!-- Barra de aviso superior -->
    <div class="top-bar">
        <div class="container top-bar-inner">
            <div>
                🏕️ <strong>Ronda Solar 2025/2026:</strong> Preinscripciones abiertas para niños y jóvenes de 6 a 21 años.
            </div>
            <div>
                ¡Ven a probar un sábado gratis sin compromiso!
                <a href="#contacto" class="top-bar-link" style="margin-left: 0.5rem;">Preinscríbete aquí →</a>
            </div>
        </div>
    </div>

    <!-- Navegación Principal -->
    <header class="site-header">
        <div class="navbar-container">
            <a href="index.html" class="nav-brand">
                <img src="images/logo.svg" alt="Logotipo Grupo Scout ACRUX 518">
                <span>ACRUX <span class="brand-red">518</span></span>
            </a>

            <ul class="nav-menu" id="navMenu">
                <li><a href="#inicio" class="nav-link active">Inicio</a></li>
                <li><a href="#quienes-somos" class="nav-link">Quiénes Somos</a></li>
                <li><a href="#finder-secciones" class="nav-link">¿Qué rama le toca?</a></li>
                <li><a href="#mochila-scout" class="nav-link">Mochila</a></li>
                <li><a href="#campamento-24h" class="nav-link">Campamento 24h</a></li>
                <li><a href="calendario.html" class="nav-link">Calendario</a></li>
                <li><a href="#faq" class="nav-link">Dudas</a></li>
                <li><a href="#contacto" class="nav-cta-btn">¡Probar un Sábado!</a></li>
            </ul>

            <div class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Abrir menú" role="button" tabindex="0">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </header>

    <!-- HERO PRINCIPAL (Luminoso, Cálido, Familiar y de Alto Impacto) -->
    <section class="hero-sunny" id="inicio">
        <div class="container">
            <div class="hero-grid">
                <!-- Columna Izquierda: Mensaje y llamada a la acción -->
                <div>
                    <div class="hero-badge-pill">
                        <span>⚜️</span> ASDE Exploradores de Castilla y León · Valladolid
                    </div>

                    <h1 class="hero-title">
                        Aprender jugando, crecer en valores y <span class="highlight">vivir la naturaleza.</span>
                    </h1>

                    <p class="hero-desc">
                        Somos el <strong>Grupo Scout ACRUX 518</strong>. Desde 1977 formamos a niños, niñas y jóvenes de 6 a 21 años en el tiempo libre en Valladolid. Un espacio donde hacer amigos para toda la vida, descubrir el mundo sin pantallas y aprender haciendo.
                    </p>

                    <!-- Pañoleta oficial Acrux 518 en el Hero -->
                    <div class="scarf-visual-card">
                        <div class="scarf-triangle" title="Pañoleta Acrux 518: Carmesí y Blanco"></div>
                        <div>
                            <span class="scarf-text-title">Nuestra Pañoleta: Rojo Carmesí y Blanco Nieve</span>
                            <span class="scarf-text-sub">Símbolo de entrega, hermandad y amor a la montaña en Valladolid desde hace más de 48 años.</span>
                        </div>
                    </div>

                    <div class="hero-buttons">
                        <a href="#contacto" class="btn-primary-scout">
                            <span>¡Ven a probar un sábado gratis!</span>
                            <span>→</span>
                        </a>
                        <a href="#finder-secciones" class="btn-secondary-scout">
                            <span>Descubre la sección por edad</span>
                            <span>🧭</span>
                        </a>
                    </div>

                    <div class="hero-checks">
                        <span><strong>✓</strong> Sábados de 16:30 a 19:00 h</span>
                        <span><strong>✓</strong> Sede en Crtra. de Rueda, 53</span>
                        <span><strong>✓</strong> 100% Voluntarios titulados</span>
                    </div>

                    <!-- Estadísticas en vivo del grupo -->
                    <div class="hero-stats-row">
                        <div class="hero-stat-box">
                            <span class="hero-stat-num">+48</span>
                            <span class="hero-stat-label">Años de Historia</span>
                        </div>
                        <div class="hero-stat-box">
                            <span class="hero-stat-num">120+</span>
                            <span class="hero-stat-label">Scouts Activos</span>
                        </div>
                        <div class="hero-stat-box">
                            <span class="hero-stat-num">15</span>
                            <span class="hero-stat-label">Días Campamento</span>
                        </div>
                        <div class="hero-stat-box">
                            <span class="hero-stat-num">5</span>
                            <span class="hero-stat-label">Ramas Educativas</span>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Foto alegre de campamento -->
                <div class="hero-photo-wrap">
                    <img src="images/DSC_04051.jpg" alt="Scouts del Acrux 518 de campamento en la naturaleza" class="hero-main-photo">
                    <div class="hero-floating-card">
                        <div class="floating-icon">🏕️</div>
                        <div>
                            <strong style="color: var(--c-text); font-size: 0.95rem; display: block;">Grupo Scout ACRUX 518</strong>
                            <span style="color: var(--c-text-muted); font-size: 0.82rem;">Educando en el tiempo libre en Valladolid desde 1977</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 1: QUIÉNES SOMOS & LOS 4 PILARES SCOUT -->
    <section class="section" id="quienes-somos">
        <div class="container">
            <div class="section-head">
                <span class="kicker">NUESTRA ESENCIA</span>
                <h2 class="section-title">¿Qué es el Escultismo en el Acrux?</h2>
                <p class="section-subtitle">
                    El escultismo es el movimiento educativo juvenil más grande del mundo. No somos una guardería ni una extraescolar al uso: somos una hermandad donde los chavales crecen seguros, autónomos y comprometidos.
                </p>
            </div>

            <div class="pillars-grid">
                <div class="pillar-card">
                    <span class="pillar-icon">🏕️</span>
                    <h3>Vida en la Naturaleza</h3>
                    <p>Campamentos de verano de 15 días en tiendas, acampadas de otoño y primavera, rutas senderistas y respeto absoluto por el medio ambiente.</p>
                </div>

                <div class="pillar-card">
                    <span class="pillar-icon">🤝</span>
                    <h3>Amistad y Valores</h3>
                    <p>Fomentamos el compañerismo, la solidaridad, el respeto mutuo y la empatía en un ambiente sano, alegre y completamente libre de pantallas.</p>
                </div>

                <div class="pillar-card">
                    <span class="pillar-icon">🎯</span>
                    <h3>Aprender Haciendo</h3>
                    <p>La pedagogía activa es nuestra seña: construcciones con troncos, cabuyería, orientación con mapa, juegos cooperativos y proyectos reales.</p>
                </div>

                <div class="pillar-card">
                    <span class="pillar-icon">❤️</span>
                    <h3>Scouters Voluntarios</h3>
                    <p>Un equipo de monitores altruistas con titulación oficial de la Escuela de Tiempo Libre de la Junta de Castilla y León dedicados a cuidar y educar.</p>
                </div>
            </div>

            <div style="text-align: center; margin-top: 2.5rem;">
                <a href="nosotros.html" class="btn-secondary-scout">
                    <span>📖 Conoce nuestra historia desde 1977 y el Kraal de Scouters</span>
                    <span>→</span>
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN INTERACTIVA WOW 1: FINDER / CALCULADORA DE SECCIÓN POR EDAD -->
    <section class="section section-alt" id="finder-secciones">
        <div class="container">
            <div class="section-head">
                <span class="kicker">SIMULADOR INTERACTIVO</span>
                <h2 class="section-title">¿Qué rama le toca a tu hijo o hija?</h2>
                <p class="section-subtitle">
                    En el Escultismo cada edad vive su propia aventura con pedagogía, juegos y marco simbólico adaptados a su desarrollo:
                </p>
            </div>

            <div class="finder-section-wrapper">
                <div class="finder-controls">
                    <div style="margin-bottom: 0.5rem; font-weight: 700; color: var(--c-text);">
                        Selecciona la edad de tu peque o joven:
                    </div>
                    <div class="age-display-bubble" id="ageBubble">8 años</div>

                    <div class="finder-slider-box">
                        <input type="range" min="6" max="20" value="8" class="finder-slider" id="ageSlider" aria-label="Selector de edad">
                    </div>

                    <div class="quick-age-btns">
                        <button type="button" class="quick-age-btn" onclick="setAge(6)">6-8 años (Castores)</button>
                        <button type="button" class="quick-age-btn active" onclick="setAge(8)">8-11 años (Lobatos)</button>
                        <button type="button" class="quick-age-btn" onclick="setAge(12)">11-14 años (Scouts)</button>
                        <button type="button" class="quick-age-btn" onclick="setAge(15)">14-17 años (Escultas)</button>
                        <button type="button" class="quick-age-btn" onclick="setAge(18)">17-21 años (Rovers)</button>
                    </div>
                </div>

                <!-- Tarjeta interactiva del Finder -->
                <div class="finder-result-card" id="finderCard">
                    <div class="finder-avatar-icon" id="finderIcon" style="background: #FEF3C7; color: #D97706;">
                        🐺
                    </div>

                    <div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                            <span class="finder-motto-tag" id="finderMottoTag" style="background: #FEF3C7; color: #92400E;">
                                Lema: «Haremos lo mejor»
                            </span>
                            <span style="font-weight: 700; font-size: 0.85rem; color: #64748B;" id="finderAgesTag">
                                8 a 11 años · 3º a 5º de Primaria
                            </span>
                        </div>

                        <h3 class="finder-info-title" id="finderTitle">
                            Manada Khanhiwara <span style="font-weight: 500; font-size: 1.2rem; color: #64748B;">(Lobatos)</span>
                        </h3>

                        <p style="color: var(--c-text-muted); font-size: 0.95rem; line-height: 1.6;" id="finderDesc">
                            Inspirada en El Libro de la Selva de Kipling. Los lobatos cazan en seisenas, aprenden las Máximas de Baloo y desarrollan su autonomía jugando en plena naturaleza.
                        </p>

                        <ul class="finder-features-list" id="finderFeatures">
                            <li><span>🌿</span> Marco simbólico de la Selva de Seeonee</li>
                            <li><span>🐾</span> Trabajo en Seisenas cooperativas</li>
                            <li><span>⛺</span> Primeras noches en tienda y acampadas</li>
                            <li><span>🎒</span> Autonomía con su propia mochila</li>
                        </ul>
                    </div>

                    <div>
                        <button type="button" class="btn-primary-scout" id="finderCtaBtn" onclick="selectSectionInForm('manada')">
                            <span>Preinscribir en Manada</span>
                            <span>→</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: LAS 5 SECCIONES COMPLETAS -->
    <section class="section" id="secciones">
        <div class="container">
            <div class="section-head">
                <span class="kicker">UN LUGAR PARA CADA EDAD</span>
                <h2 class="section-title">Nuestras 5 Ramas Educativas</h2>
                <p class="section-subtitle">
                    Descubre el itinerario pedagógico completo por el que pasa cada scout en el Acrux 518:
                </p>
            </div>

            <div class="branches-cards-grid">
                <!-- 1. Castores -->
                <div class="branch-family-card branch-castores">
                    <div class="branch-header-top">
                        <span class="branch-symbol">🦫</span>
                        <span class="branch-age-tag tag-castores">6 a 8 años</span>
                    </div>
                    <div class="branch-real-name">Colonia Ohiensis</div>
                    <h3 class="branch-unit-title">Castores</h3>
                    <div class="branch-motto-quote">«Compartir»</div>
                    <p class="branch-unit-desc">
                        1º y 2º de Primaria. Sus primeros pasos en el grupo. A través de cuentos, juegos cooperativos y manualidades en el bosque aprenden a convivir y a compartir con alegría.
                    </p>
                    <a href="#contacto" onclick="selectSectionInForm('castores')" class="branch-details-link">Preguntar por Castores →</a>
                </div>

                <!-- 2. Manada -->
                <div class="branch-family-card branch-manada">
                    <div class="branch-header-top">
                        <span class="branch-symbol">🐺</span>
                        <span class="branch-age-tag tag-manada">8 a 11 años</span>
                    </div>
                    <div class="branch-real-name">Manada Khanhiwara</div>
                    <h3 class="branch-unit-title">Lobatos</h3>
                    <div class="branch-motto-quote">«Haremos lo mejor»</div>
                    <p class="branch-unit-desc">
                        3º a 5º de Primaria. El marco simbólico de <em>El Libro de las Tierras Vírgenes</em> (Mowgli). Aprenden a ser autónomos, cuidan de su mochila y duermen en tiendas de campaña.
                    </p>
                    <a href="#contacto" onclick="selectSectionInForm('manada')" class="branch-details-link">Preguntar por Lobatos →</a>
                </div>

                <!-- 3. Tropa -->
                <div class="branch-family-card branch-tropa">
                    <div class="branch-header-top">
                        <span class="branch-symbol">⚜️</span>
                        <span class="branch-age-tag tag-tropa">11 a 14 años</span>
                    </div>
                    <div class="branch-real-name">Tropa Lohengrin</div>
                    <h3 class="branch-unit-title">Scouts</h3>
                    <div class="branch-motto-quote">«Siempre Listos»</div>
                    <p class="branch-unit-desc">
                        6º de Primaria a 2º de ESO. El corazón del escultismo. Se organizan en Patrullas autónomas con cargos propios, hacen construcciones de madera, cabuyería y marchas de montaña.
                    </p>
                    <a href="#contacto" onclick="selectSectionInForm('tropa')" class="branch-details-link">Preguntar por Scouts →</a>
                </div>

                <!-- 4. Escultas -->
                <div class="branch-family-card branch-esculta">
                    <div class="branch-header-top">
                        <span class="branch-symbol">🥾</span>
                        <span class="branch-age-tag tag-esculta">14 a 17 años</span>
                    </div>
                    <div class="branch-real-name">Unidad Trea</div>
                    <h3 class="branch-unit-title">Escultas</h3>
                    <div class="branch-motto-quote">«Unidad»</div>
                    <p class="branch-unit-desc">
                        3º-4º ESO y 1º Bachillerato. Jóvenes pioneros que gestionan y financian sus propias «Empresas»: expediciones de aventura, viajes de impacto social y causas solidarias.
                    </p>
                    <a href="#contacto" onclick="selectSectionInForm('esculta')" class="branch-details-link">Preguntar por Escultas →</a>
                </div>

                <!-- 5. Clan -->
                <div class="branch-family-card branch-clan">
                    <div class="branch-header-top">
                        <span class="branch-symbol">🌿</span>
                        <span class="branch-age-tag tag-clan">17 a 21 años</span>
                    </div>
                    <div class="branch-real-name">Clan Ama Dablam</div>
                    <h3 class="branch-unit-title">Rovers</h3>
                    <div class="branch-motto-quote">«Servir»</div>
                    <p class="branch-unit-desc">
                        Jóvenes adultos comprometidos. Realizan voluntariado en asociaciones y ONGs, debaten sobre la sociedad y se forman como futuros educadores de tiempo libre.
                    </p>
                    <a href="#contacto" onclick="selectSectionInForm('clan')" class="branch-details-link">Preguntar por Clan →</a>
                </div>
            </div>

            <div style="text-align: center; margin-top: 2.5rem;">
                <a href="secciones.html" class="btn-secondary-scout">
                    <span>🔍 Ver lemas, metodología, uniformes y actividades de cada sección</span>
                    <span>→</span>
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN INTERACTIVA WOW 2: SIMULADOR DE MOCHILA SCOUT -->
    <section class="section section-alt" id="mochila-scout">
        <div class="container">
            <div class="section-head">
                <span class="kicker">CHECKLIST INTERACTIVA</span>
                <h2 class="section-title">¿Qué metemos en la mochila scout?</h2>
                <p class="section-subtitle">
                    Prueba nuestro empaquetador interactivo: selecciona el tipo de salida y marca los elementos que vas guardando:
                </p>
            </div>

            <div class="backpack-section-card">
                <!-- Selector de tipo de salida -->
                <div class="backpack-type-nav">
                    <button type="button" class="backpack-type-btn active" onclick="switchBackpackType('sabado', this)">
                        <span>🎒</span> Salida de Sábado
                    </button>
                    <button type="button" class="backpack-type-btn" onclick="switchBackpackType('acampada', this)">
                        <span>⛺</span> Acampada Fin de Semana
                    </button>
                    <button type="button" class="backpack-type-btn" onclick="switchBackpackType('campamento', this)">
                        <span>🏔️</span> Campamento de Verano (15 Días)
                    </button>
                </div>

                <div class="backpack-grid">
                    <!-- Lista de checklist táctil -->
                    <div>
                        <div class="gear-checklist" id="gearChecklist">
                            <!-- Inyectado por JS -->
                        </div>
                    </div>

                    <!-- Panel de estado y progreso -->
                    <div class="backpack-status-panel">
                        <div class="backpack-meter-circle" id="meterCircle">
                            <span class="meter-pct" id="meterPct">0%</span>
                            <span class="meter-sub">Empacado</span>
                        </div>

                        <h4 style="font-family: var(--font-heading); font-size: 1.15rem; color: var(--c-text); margin-bottom: 0.35rem;" id="meterStatusTitle">
                            Mochila vacía
                        </h4>
                        <p style="font-size: 0.86rem; color: var(--c-text-muted);" id="meterStatusSubtitle">
                            Haz clic en los elementos de la izquierda para guardarlos.
                        </p>

                        <div class="backpack-progress-bar-wrap">
                            <div class="backpack-progress-bar-fill" id="meterBar"></div>
                        </div>

                        <div class="scouter-pro-tip" id="scouterTip">
                            <strong>💡 Consejo del Scouter:</strong> El saco de dormir va siempre en el fondo de la mochila, y el chubasquero o capelina en la seta superior por si empieza a llover.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN INTERACTIVA WOW 3: UN DÍA EN EL CAMPAMENTO (24H INTERACTIVAS) -->
    <section class="section" id="campamento-24h">
        <div class="container">
            <div class="section-head">
                <span class="kicker">LA GRAN AVENTURA</span>
                <h2 class="section-title">24 Horas en el Campamento de Verano</h2>
                <p class="section-subtitle">
                    15 días en plena naturaleza sin pantallas. Haz clic en las horas del día para descubrir el ritmo de vida scout:
                </p>
            </div>

            <div class="camp-timeline-wrapper">
                <!-- Botones horarios -->
                <div class="time-slots-container" id="timeSlotsBar">
                    <button type="button" class="time-slot-pill active" onclick="showCampHour(0, this)">🌅 08:30 Diana</button>
                    <button type="button" class="time-slot-pill" onclick="showCampHour(1, this)">⚜️ 09:15 Izada</button>
                    <button type="button" class="time-slot-pill" onclick="showCampHour(2, this)">🪵 10:30 Construcciones</button>
                    <button type="button" class="time-slot-pill" onclick="showCampHour(3, this)">🍲 14:00 El Rancho</button>
                    <button type="button" class="time-slot-pill" onclick="showCampHour(4, this)">🌊 16:30 Rutas & Pozas</button>
                    <button type="button" class="time-slot-pill" onclick="showCampHour(5, this)">🏕️ 20:30 Arriada</button>
                    <button type="button" class="time-slot-pill" onclick="showCampHour(6, this)">🔥 22:00 Fuego Campamento</button>
                </div>

                <!-- Tarjeta interactiva del momento -->
                <div class="timeline-content-card">
                    <div>
                        <img src="images/DSC_04051.jpg" alt="Momento del campamento" class="timeline-card-photo" id="campPhoto">
                    </div>
                    <div class="timeline-card-body">
                        <span class="timeline-hour-tag" id="campHourTag">08:30 h · ¡Arriba el campamento!</span>
                        <h3 class="timeline-title" id="campTitle">Diana y Saludo al Sol</h3>
                        <p class="timeline-desc" id="campDesc">
                            Suena la canción de diana o el silbato scouter entre los pinos. Salimos de las tiendas canadienses, estiramientos al aire fresco de la montaña y aseo personal antes de un desayuno reconfortante con galletas y leche caliente.
                        </p>
                        <div class="timeline-scout-quote" id="campQuote">
                            «Un scout se levanta con alegría y agradece el nuevo día en la naturaleza.»
                        </div>

                        <!-- Botón de sonido ambiental de fuego de campamento -->
                        <div id="campfireSoundBox" style="display: none;">
                            <button type="button" class="campfire-sound-pill" id="campfireAudioBtn" onclick="toggleCampfireSound()">
                                <span>🔥</span> <span id="campfireAudioText">Escuchar el crepitar del fuego</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: CAMPAMENTOS & GALERÍA DE FOTOS -->
    <section class="section section-alt" id="campamentos">
        <div class="container">
            <div class="camps-banner">
                <div class="camps-banner-body">
                    <span class="kicker">CAMPAMENTOS DE VERANO E INVIERNO</span>
                    <h2 class="section-title">El Momento Cumbre de la Ronda</h2>
                    <p style="color: var(--c-text-muted); font-size: 1.05rem; line-height: 1.65; margin-bottom: 1.5rem;">
                        <strong>15 días cada mes de julio</strong> en tiendas de campaña en valles alpinos (Pirineos, Picos de Europa, Sistema Central). Cocina propia, baños en pozas, fuegos de campamento bajo las estrellas y rutas de montaña.
                    </p>
                    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                        <a href="campamentos.html" class="btn-primary-scout">Descubre la guía de campamentos →</a>
                        <a href="#contacto" class="btn-secondary-scout">Consultar plazas disponibles</a>
                    </div>
                </div>
                <div class="camps-banner-img">
                    <img src="images/DSC_064012.jpg" alt="Construcciones y vida de campamento scout">
                </div>
            </div>

            <!-- Galería de fotos limpia -->
            <div class="section-head" style="margin-bottom: 2rem;">
                <h3 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--c-text);">Momentos de Nuestro Grupo</h3>
            </div>
            <div class="photo-gallery-clean">

                colorText: '#0369A1',
                desc: '1º y 2º de Primaria. Sus primeros pasos en el grupo. A través de cuentos del Gran Castor, juegos cooperativos y manualidades en el bosque aprenden a convivir y compartir con alegría.',
                features: ['🪵 El Gran Dique y la Colonia', '🎨 Juegos cooperativos y risas', '🌳 Primer contacto con la naturaleza', '🧸 Aprender a compartir con otros']
            },
            manada: {
                name: 'Manada Khanhiwara',
                unit: 'Lobatos',
                ages: '8 a 11 años · 3º a 5º Primaria',
                icon: '🐺',
                motto: 'Lema: «Haremos lo mejor»',
                colorBg: '#FEF3C7',
                colorText: '#92400E',
                desc: 'Inspirada en El Libro de la Selva de Kipling. Los lobatos cazan en seisenas, aprenden las Máximas de Baloo y desarrollan su autonomía jugando en plena naturaleza.',
                features: ['🌿 Marco simbólico de la Selva de Seeonee', '🐾 Trabajo en Seisenas cooperativas', '⛺ Primeras noches en tienda y acampadas', '🎒 Autonomía con su propia mochila']
            },
            tropa: {
                name: 'Tropa Lohengrin',
                unit: 'Scouts',
                ages: '11 a 14 años · 6º Primaria a 2º ESO',
                icon: '⚜️',
                motto: 'Lema: «Siempre Listos»',
                colorBg: '#DCFCE7',
                colorText: '#166534',
                desc: '6º Primaria a 2º ESO. El corazón del escultismo. Se organizan en Patrullas autónomas con cargos propios, hacen construcciones de madera, cabuyería y marchas de montaña.',
                features: ['🏕️ Sistema de Patrullas autónomas', '🪢 Construcciones de pionerismo y cabuyería', '🏔️ Vivac al aire libre y cumbres', '🧭 Orientación con brújula y mapa IGN']
            },
            esculta: {
                name: 'Unidad Trea',
                unit: 'Escultas',
                ages: '14 a 17 años · 3º-4º ESO y 1º Bach',
                icon: '🥾',
                motto: 'Lema: «Unidad»',
                colorBg: '#FEE2E2',
                colorText: '#991B1B',
                desc: '3º-4º ESO y 1º Bachillerato. Jóvenes pioneros que gestionan y financian sus propias «Empresas»: expediciones de aventura, viajes de impacto social y causas solidarias.',
                features: ['🗺️ Autogestión de «Empresas» y proyectos', '🧗 Alta montaña y travesías invernales', '🤝 Compromiso social y voluntariado', '⛺ Supervivencia y autonomía real']
            },
            clan: {
                name: 'Clan Ama Dablam',
                unit: 'Rovers',
                ages: '17 a 21 años · Universidad y Jóvenes',
                icon: '🌿',
                motto: 'Lema: «Servir»',
                colorBg: '#F3E8FF',
                colorText: '#6B21A8',
                desc: 'Jóvenes adultos comprometidos. Realizan voluntariado en asociaciones y ONGs, debaten sobre la sociedad y se forman como futuros educadores de tiempo libre.',
                features: ['🤝 Proyectos de servicio a la comunidad', '🎒 Rutas de descubrimiento (GRs) autónomas', '📜 Formación de monitores de tiempo libre', '⚖️ Debate crítico y ciudadanía activa']
            }
        };

        const ageSlider = document.getElementById('ageSlider');
        const ageBubble = document.getElementById('ageBubble');
        const finderCard = document.getElementById('finderCard');
        const finderIcon = document.getElementById('finderIcon');
        const finderTitle = document.getElementById('finderTitle');
        const finderAgesTag = document.getElementById('finderAgesTag');
        const finderMottoTag = document.getElementById('finderMottoTag');
        const finderDesc = document.getElementById('finderDesc');
        const finderFeatures = document.getElementById('finderFeatures');
        const finderCtaBtn = document.getElementById('finderCtaBtn');

        function updateFinderByAge(age) {
            let key = 'manada';
            if (age < 8) key = 'castores';
            else if (age <= 10) key = 'manada';
            else if (age <= 13) key = 'tropa';
            else if (age <= 16) key = 'esculta';
            else key = 'clan';

            const b = branchData[key];
            if (!b) return;

            ageBubble.textContent = age + ' años';
            finderIcon.textContent = b.icon;
            finderIcon.style.background = b.colorBg;
            finderIcon.style.color = b.colorText;

            finderMottoTag.textContent = b.motto;
            finderMottoTag.style.background = b.colorBg;
            finderMottoTag.style.color = b.colorText;

            finderAgesTag.textContent = b.ages;
            finderTitle.innerHTML = b.name + ' <span style="font-weight: 500; font-size: 1.2rem; color: #64748B;">(' + b.unit + ')</span>';
            finderDesc.textContent = b.desc;

            finderFeatures.innerHTML = b.features.map(f => '<li><span>✓</span> ' + f + '</li>').join('');
            finderCtaBtn.innerHTML = '<span>Preinscribir en ' + b.unit + '</span> <span>→</span>';
            finderCtaBtn.onclick = () => selectSectionInForm(key);

            // Resaltar botón rápido activo
            document.querySelectorAll('.quick-age-btn').forEach(btn => btn.classList.remove('active'));
        }

        if (ageSlider) {
            ageSlider.addEventListener('input', (e) => {
                updateFinderByAge(parseInt(e.target.value, 10));
            });
        }

        function setAge(age) {
            if (ageSlider) {
                ageSlider.value = age;
                updateFinderByAge(age);
            }
        }

        function selectSectionInForm(secKey) {
            const select = document.getElementById('sectionSelect');
            if (select) {
                select.value = secKey;
            }
            const contactSection = document.getElementById('contacto');
            if (contactSection) {
                contactSection.scrollIntoView({ behavior: 'smooth' });
            }
        }

        // 3. SIMULADOR DE MOCHILA SCOUT
        const gearPresets = {
            sabado: [
                { id: 'mochila_peq', title: 'Mochila pequeña (15-20L)', tag: 'Cómoda con tirantes' },
                { id: 'cantimplora', title: 'Cantimplora con agua fresca', tag: 'Mínimo 0.75 L' },
                { id: 'almuerzo', title: 'Comida de ataque / Merienda', tag: 'Fruta, frutos secos, bocata' },
                { id: 'chubasquero', title: 'Chubasquero o capelina', tag: 'Por si cambia el tiempo' },
                { id: 'panoleta', title: 'Pañoleta Acrux 518 al cuello', tag: 'Uniforme scout' },
                { id: 'gorra', title: 'Gorra o braga de cuello', tag: 'Protección solar' }
            ],
            acampada: [
                { id: 'saco', title: 'Saco de dormir confort 0ºC', tag: 'En el fondo de la mochila' },
                { id: 'aislante', title: 'Esterilla o aislante térmico', tag: 'Para aislar del frío del suelo' },
                { id: 'cantimplora', title: 'Cantimplora 1L', tag: 'Hidratación continua' },
                { id: 'frontal', title: 'Linterna frontal con pilas nuevas', tag: 'Manos libres de noche' },
                { id: 'neceser', title: 'Neceser biodegradable y toalla', tag: 'Cepillo, pasta, jabón' },
                { id: 'botas', title: 'Botas de montaña usadas', tag: 'Sujeción de tobillo' },
                { id: 'ropa_repuesto', title: 'Muda completa y calcetines secos', tag: 'Guardados en bolsa estanca' },
                { id: 'plato_cubiertos', title: 'Plato hondo, poto y cubiertos', tag: 'De acero o plástico duro' },
                { id: 'panoleta', title: 'Pañoleta Acrux 518', tag: 'Identidad del grupo' }
            ],
            campamento: [
                { id: 'mochilon', title: 'Mochilón de expedición (50-70L)', tag: 'Bien ajustado a la espalda' },
                { id: 'saco_camp', title: 'Saco de dormir de montaña (0º a -5ºC)', tag: 'Noches frías en altura' },
                { id: 'aislante_camp', title: 'Aislante de alta densidad', tag: 'Aislamiento térmico' },
                { id: 'ropa_15dias', title: 'Ropa para 15 días en rulos', tag: 'Organizada en bolsas de tela' },
                { id: 'botas_trekking', title: 'Botas de montaña + zapatillas río', tag: 'Doble calzado' },
                { id: 'chubasquero_pro', title: 'Chubasquero transpirable / Capelina', tag: 'Tormentas de verano' },
                { id: 'frontal_repuesto', title: 'Frontal + pilas de repuesto', tag: 'Para las veladas' },
                { id: 'menaje', title: 'Vajilla scout completa en bolsa de tela', tag: 'Plato, poto, tenedor, cuchara' },
                { id: 'crema_repelente', title: 'Protector solar 50+ y repelente', tag: 'Salud en la montaña' },
                { id: 'tarjeta_sanitaria', title: 'Tarjeta sanitaria original', tag: 'Custodiada por scouters' },
                { id: 'panoleta_camisa', title: 'Camisa scout y pañoleta Acrux', tag: 'Uniforme de izada' },
                { id: 'banyador', title: 'Bañador y toalla de microfibra', tag: 'Para las pozas y ríos' }
            ]
        };

        let currentGearPreset = 'sabado';
        let packedItems = new Set();

        function renderGearList() {
            const listContainer = document.getElementById('gearChecklist');
            if (!listContainer) return;

            const items = gearPresets[currentGearPreset] || [];
            listContainer.innerHTML = items.map(item => {
                const isPacked = packedItems.has(item.id);
                return `
                    <div class="gear-item ${isPacked ? 'packed' : ''}" onclick="toggleGearItem('${item.id}')">
                        <div class="gear-check">${isPacked ? '✓' : ''}</div>
                        <div>
                            <div class="gear-title">${item.title}</div>
                            <span class="gear-tag">${item.tag}</span>
                        </div>
                    </div>
                `;
            }).join('');

            updateBackpackProgress();
        }

        function toggleGearItem(id) {
            if (packedItems.has(id)) {
                packedItems.delete(id);
            } else {
                packedItems.add(id);
            }
            renderGearList();
        }

        function switchBackpackType(presetKey, btn) {
            currentGearPreset = presetKey;
            packedItems.clear();
            document.querySelectorAll('.backpack-type-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            renderGearList();
        }

        function updateBackpackProgress() {
            const total = (gearPresets[currentGearPreset] || []).length;
            const packed = packedItems.size;
            const pct = total > 0 ? Math.round((packed / total) * 100) : 0;

            const pctEl = document.getElementById('meterPct');
            const barEl = document.getElementById('meterBar');
            const titleEl = document.getElementById('meterStatusTitle');
            const subEl = document.getElementById('meterStatusSubtitle');
            const circleEl = document.getElementById('meterCircle');

            if (pctEl) pctEl.textContent = pct + '%';
            if (barEl) barEl.style.width = pct + '%';

            if (pct === 0) {
                if (titleEl) titleEl.textContent = 'Mochila vacía';
                if (subEl) subEl.textContent = 'Marca los objetos de la lista para empacarlos.';
                if (circleEl) circleEl.style.borderColor = '#E2E8F0';
            } else if (pct < 100) {
                if (titleEl) titleEl.textContent = 'Mochila en preparación...';
                if (subEl) subEl.textContent = `Llevas ${packed} de ${total} objetos esenciales listos.`;
                if (circleEl) circleEl.style.borderColor = '#F59E0B';
            } else {
                if (titleEl) titleEl.textContent = '🎉 ¡Mochila 100% Lista!';
                if (subEl) subEl.textContent = '¡Todo guardado y listo para partir a la naturaleza!';
                if (circleEl) circleEl.style.borderColor = '#16A34A';
            }
        }

        // 4. TIMELINE DE 24 HORAS EN EL CAMPAMENTO
        const campHours = [
            {
                hour: '08:30 h · ¡Arriba el campamento!',
                title: 'Diana y Saludo al Sol',
                desc: 'Suena la diana o el silbato scouter entre los pinos. Salimos de las tiendas canadienses, estiramientos al aire fresco de la montaña y aseo personal antes de un desayuno reconfortante con galletas y leche caliente.',
                quote: '«Un scout se levanta con alegría y agradece el nuevo día en la naturaleza.»',
                photo: 'images/DSC_04051.jpg',
                isCampfire: false
            },
            {
                hour: '09:15 h · Formación matinal',
                title: 'Izada de Bandera & Himno del Grupo',
                desc: 'Todo el campamento formado en herradura con pañoleta y camisa. Izada de la bandera del Acrux 518 y de ASDE, canto del himno scout y reparto de las tareas del día (limpieza, leña, cocina).',
                quote: '«La formación une a castores, lobatos, tropa, escultas y rovers en una misma hermandad.»',
                photo: 'images/DSC_058812.jpg',
                isCampfire: false
            },
            {
                hour: '10:30 h · Pionerismo y aventura',
                title: 'Construcciones y Grandes Juegos',
                desc: 'Troncos, cuerdas y cabuyería. Los scouts construyen sus propios refectorios, zapateros, portadas de campamento y mesas de madera sin un solo clavo, seguidos de grandes juegos de estrategia en el bosque.',
                quote: '«Aprender haciendo: cuando un chaval levanta su propia mesa de patrulla, gana confianza para toda la vida.»',
                photo: 'images/DSC_064012.jpg',
                isCampfire: false
            },
            {
                hour: '14:00 h · El Rancho',
                title: 'Comida Casera y Hermandad',
                desc: 'Comida caliente cocinada en el campamento: lentejas con verduras, macarrones, ensaladas frescas y fruta de temporada. Tras la comida, tiempo libre para escribir cartas a las familias o jugar a las cartas a la sombra.',
                quote: '«La mejor comida sabe a campamento, risas entre amigos y aire puro.»',
                photo: 'images/DSC_059812.jpg',
                isCampfire: false
            },
            {
                hour: '16:30 h · Actividad de tarde',
                title: 'Rutas Senderistas & Baño en Pozas',
                desc: 'Excursiones por senderos de montaña guiados por los scouters, talleres medioambientales de huellas de animales, rastreo y un merecido baño refrescante en las pozas naturales del río de montaña.',
                quote: '«Deja el mundo en mejores condiciones de como lo encontraste.» — Baden-Powell',
                photo: 'images/DSC_3166.jpg',
                isCampfire: false
            },
            {
                hour: '20:30 h · Caída del sol',
                title: 'Arriada de Bandera & Cena',
                desc: 'Se recoge la bandera antes de que se oculte el sol. Cena ligera y caliente bajo los chopos mientras la temperatura refresca y el cielo se llena de estrellas.',
                quote: '«La calma de la montaña al atardecer no tiene precio.»',
                photo: 'images/DSC_04051.jpg',
                isCampfire: false
            },
            {
                hour: '22:00 h · El momento mágico',
                title: '¡El Gran Fuego de Campamento!',
                desc: 'El momento más recordado del año. Alrededor de las brasas del fuego, cantamos el Ani Kuni, representamos sketches cómicos de patrulla y compartimos reflexiones antes del toque de silencio bajo un manto de millones de estrellas.',
                quote: '«Las brasas del fuego scout nunca se apagan en el corazón de quien las ha vivido.»',
                photo: 'images/DSC_066412.jpg',
                isCampfire: true
            }
        ];

        function showCampHour(idx, btn) {
            const data = campHours[idx];
            if (!data) return;

            document.getElementById('campHourTag').textContent = data.hour;
            document.getElementById('campTitle').textContent = data.title;
            document.getElementById('campDesc').textContent = data.desc;
            document.getElementById('campQuote').textContent = data.quote;
            document.getElementById('campPhoto').src = data.photo;

            const soundBox = document.getElementById('campfireSoundBox');
            if (soundBox) {
                soundBox.style.display = data.isCampfire ? 'block' : 'none';
            }

            document.querySelectorAll('.time-slot-pill').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
        }

        // Efecto de sonido del fuego de campamento mediante Web Audio API
        let audioCtx = null;
        let isCampfirePlaying = false;
        let campfireInterval = null;

        function toggleCampfireSound() {
            const btnText = document.getElementById('campfireAudioText');
            if (isCampfirePlaying) {
                stopCampfireSound();
                if (btnText) btnText.textContent = 'Escuchar el crepitar del fuego';
                isCampfirePlaying = false;
            } else {
                startCampfireSound();
                if (btnText) btnText.textContent = 'Silenciar fuego';
                isCampfirePlaying = true;
            }
        }

        function startCampfireSound() {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }

                // Generar crepitar suave de brasas mediante impulsos aleatorios filtrados
                campfireInterval = setInterval(() => {
                    if (!audioCtx || !isCampfirePlaying) return;
                    if (Math.random() < 0.35) {
                        const bufferSize = audioCtx.sampleRate * 0.05;
                        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                        const data = buffer.getChannelData(0);
                        for (let i = 0; i < bufferSize; i++) {
                            data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.3));
                        }
                        const noise = audioCtx.createBufferSource();
                        noise.buffer = buffer;
                        const filter = audioCtx.createBiquadFilter();
                        filter.type = 'bandpass';
                        filter.frequency.value = 800 + Math.random() * 2000;
                        const gain = audioCtx.createGain();
                        gain.gain.value = 0.08 + Math.random() * 0.12;
                        noise.connect(filter);
                        filter.connect(gain);
                        gain.connect(audioCtx.destination);
                        noise.start();
                    }
                }, 40);
            } catch (err) {
                console.log('Audio no disponible:', err);
            }
        }

        function stopCampfireSound() {
            if (campfireInterval) {
                clearInterval(campfireInterval);
                campfireInterval = null;
            }
        }

        // 5. ACORDEÓN DE PREGUNTAS FRECUENTES (FAQ)
        document.querySelectorAll('.accordion-header').forEach(header => {
            header.addEventListener('click', () => {
                const item = header.parentElement;
                const isOpen = item.classList.contains('open');
                document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('open'));
                if (!isOpen) {
                    item.classList.add('open');
                }
            });
        });

        // 6. FORMULARIO DE CONTACTO & WHATSAPP
        const contactForm = document.getElementById('contactForm');
        const formSuccess = document.getElementById('formSuccess');

        if (contactForm && formSuccess) {
            contactForm.addEventListener('submit', (e) => {
                e.preventDefault();
                formSuccess.style.display = 'block';
                contactForm.reset();
                setTimeout(() => {
                    formSuccess.style.display = 'none';
                }, 7000);
            });
        }

        function sendFormByWhatsApp() {
            const name = document.getElementById('name').value.trim() || 'Una familia';
            const childName = document.getElementById('childName').value.trim() || 'mi hijo/a';
            const phone = document.getElementById('phone').value.trim() || '';
            const section = document.getElementById('sectionSelect').selectedOptions[0].text;
            const msg = document.getElementById('message').value.trim();

            const text = `¡Hola Marta! Soy ${name}. Me gustaría recibir información para probar un sábado gratis en el Grupo Scout Acrux 518.%0A%0A` +
                         `👦👧 Niño/a: ${childName}%0A` +
                         `⚜️ Rama de interés: ${section}%0A` +
                         (phone ? `📞 Teléfono: ${phone}%0A` : '') +
                         (msg ? `💬 Mensaje: ${msg}` : '');

            window.open(`https://wa.me/34619202068?text=${text}`, '_blank');
        }

        // Inicializar componentes al cargar la página
        window.addEventListener('DOMContentLoaded', () => {
            updateFinderByAge(8);
            renderGearList();
        });
    </script>
</body>
</html>
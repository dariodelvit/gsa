/* ==========================================================================
   GRUPO SCOUT ACRUX 518 · DISEÑO LUMINOSO, CÁLIDO Y SCOUT
   Aesthetic: Bright, Friendly, Youth & Family Oriented · Carmesí & Blanco
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap');

:root {
    /* Colores Oficiales ACRUX 518 */
    --c-primary: #B02324;          /* Rojo Carmesí Scout */
    --c-primary-hover: #961B1C;
    --c-primary-light: #FDF2F2;    /* Fondo suave carmesí */
    --c-primary-border: #FCA5A5;

    /* Neutros Luminosos */
    --c-white: #FFFFFF;
    --c-bg-light: #F8FAFC;
    --c-bg-warm: #FFFDF9;
    --c-border: #E2E8F0;
    --c-text: #0F172A;            /* Texto principal nítido */
    --c-text-muted: #475569;      /* Texto secundario */
    --c-text-light: #64748B;

    /* Colores Educativos de Ramas */
    --c-castores: #0284C7;
    --c-castores-bg: #E0F2FE;
    --c-manada: #D97706;
    --c-manada-bg: #FEF3C7;
    --c-tropa: #16A34A;
    --c-tropa-bg: #DCFCE7;
    --c-esculta: #B02324;
    --c-esculta-bg: #FEE2E2;
    --c-clan: #7C3AED;
    --c-clan-bg: #F3E8FF;

    /* Tipografía */
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

    /* Radios y Sombras */
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --radius-pill: 9999px;
    --shadow-subtle: 0 2px 10px rgba(0, 0, 0, 0.04);
    --shadow-card: 0 8px 24px rgba(15, 23, 42, 0.06);
    --shadow-hover: 0 14px 35px rgba(176, 35, 36, 0.12);
    --transition: all 0.25s ease;
}

/* Reset y Base */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
    background-color: var(--c-white);
    color: var(--c-text);
}

body {
    font-family: var(--font-body);
    line-height: 1.65;
    background-color: var(--c-white);
    color: var(--c-text);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
    transition: var(--transition);
}

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
}

.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

/* ==========================================================================
   BARRA SUPERIOR & NAVEGACIÓN LIMPIA Y LUMINOSA
   ========================================================================== */

.top-bar {
    background: #FFF1F2;
    border-bottom: 1px solid #FFE4E6;
    padding: 0.55rem 0;
    font-size: 0.88rem;
    color: #9F1239;
}

.top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.top-bar-link {
    font-weight: 700;
    color: var(--c-primary);
    text-decoration: underline;
}

.top-bar-link:hover {
    color: var(--c-primary-hover);
}

/* Navbar Principal */
.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-border);
}

.navbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 24px;
    max-width: 1200px;
    margin: 0 auto;
}

.nav-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.25rem;
    color: var(--c-text);
}

.nav-brand img {
    height: 38px;
    width: auto;
}

.nav-brand span.brand-red {
    color: var(--c-primary);
}

.nav-menu {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
}

.nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--c-text-muted);
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-sm);
    transition: var(--transition);
}

.nav-link:hover, .nav-link.active {
    color: var(--c-primary);
    background: var(--c-primary-light);
}

.nav-cta-btn {
    background: var(--c-primary);
    color: #FFFFFF !important;
    padding: 0.6rem 1.35rem;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.9rem;
    margin-left: 0.5rem;
    box-shadow: 0 4px 14px rgba(176, 35, 36, 0.25);
    transition: var(--transition);
}

.nav-cta-btn:hover {
    background: var(--c-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(176, 35, 36, 0.35);
}

.mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    cursor: pointer;
}

.mobile-menu-btn span {
    width: 24px;
    height: 3px;
    background: var(--c-text);
    border-radius: 2px;
}

/* ==========================================================================
   HERO: LUMINOSO, AMABLE Y SCOUT
   ========================================================================== */

.hero-sunny {
    background: linear-gradient(180deg, #FFFDFB 0%, #F8FAFC 100%);
    padding: 70px 0 90px 0;
    border-bottom: 1px solid var(--c-border);
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
}

.hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--c-primary-light);
    border: 1px solid var(--c-primary-border);
    color: var(--c-primary);
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.25rem;
}

.scarf-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--c-text-muted);
}

.scarf-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, #B02324 50%, #FFFFFF 50%);
    border: 1px solid #CBD5E1;
    display: inline-block;
}

.hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 4vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin-bottom: 1.25rem;
}

.hero-title .highlight {
    color: var(--c-primary);
}

.hero-desc {
    font-size: 1.12rem;
    color: var(--c-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
}

.btn-primary-scout {
    background: var(--c-primary);
    color: #FFFFFF !important;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.95rem 1.85rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 6px 20px rgba(176, 35, 36, 0.28);
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-primary-scout:hover {
    background: var(--c-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(176, 35, 36, 0.38);
}

.btn-secondary-scout {
    background: #FFFFFF;
    color: var(--c-text) !important;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.95rem 1.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-subtle);
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-secondary-scout:hover {
    border-color: var(--c-primary);
    color: var(--c-primary) !important;
    transform: translateY(-2px);
}

.hero-checks {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--c-text-muted);
}

.hero-checks span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.hero-checks span strong {
    color: var(--c-primary);
}

/* Columna Imagen Hero */
.hero-photo-wrap {
    position: relative;
}

.hero-main-photo {
    width: 100%;
    height: 440px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
    border: 4px solid #FFFFFF;
}

.hero-floating-card {
    position: absolute;
    bottom: -20px;
    left: 20px;
    background: #FFFFFF;
    border-radius: var(--radius-md);
    padding: 1.1rem 1.4rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    border: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.floating-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--c-primary-light);
    color: var(--c-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
}

/* ==========================================================================
   SECCIONES GENERALES & ENCABEZADOS
   ========================================================================== */

.section {
    padding: 85px 0;
}

.section-alt {
    background-color: var(--c-bg-light);
}

.section-warm {
    background-color: var(--c-bg-warm);
}

.section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
}

.kicker {
    display: inline-block;
    color: var(--c-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
}

.section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: var(--c-text);
    margin-bottom: 0.75rem;
    line-height: 1.2;
}

.section-subtitle {
    font-size: 1.05rem;
    color: var(--c-text-muted);
    line-height: 1.6;
}

/* ==========================================================================
   PILAREAS DEL MÉTODO SCOUT (Tarjetas Blancas y Claras)
   ========================================================================== */

.pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
}

.pillar-card {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem 1.75rem;
    box-shadow: var(--shadow-subtle);
    transition: var(--transition);
}

.pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--c-primary-border);
}

.pillar-icon {
    font-size: 2.4rem;
    margin-bottom: 1rem;
    display: inline-block;
}

.pillar-card h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--c-text);
    margin-bottom: 0.5rem;
}

.pillar-card p {
    font-size: 0.95rem;
    color: var(--c-text-muted);
    line-height: 1.6;
}

/* ==========================================================================
   LAS 5 SECCIONES (Con sus nombres auténticos: Colonia Ohiensis, etc.)
   ========================================================================== */

.branches-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
}

.branch-family-card {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: var(--transition);
}

.branch-family-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
}

.branch-family-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
}

/* Colores de Rama */
.branch-castores::before { background: var(--c-castores); }
.branch-manada::before   { background: var(--c-manada); }
.branch-tropa::before    { background: var(--c-tropa); }
.branch-esculta::before  { background: var(--c-esculta); }
.branch-clan::before     { background: var(--c-clan); }

.branch-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.branch-symbol {
    font-size: 2.2rem;
}

.branch-age-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
}

.tag-castores { background: var(--c-castores-bg); color: var(--c-castores); }
.tag-manada   { background: var(--c-manada-bg); color: var(--c-manada); }
.tag-tropa    { background: var(--c-tropa-bg); color: var(--c-tropa); }
.tag-esculta  { background: var(--c-esculta-bg); color: var(--c-esculta); }
.tag-clan     { background: var(--c-clan-bg); color: var(--c-clan); }

.branch-real-name {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
}

.branch-unit-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--c-text);
    margin-bottom: 0.25rem;
}

.branch-motto-quote {
    font-size: 0.88rem;
    font-style: italic;
    font-weight: 600;
    color: var(--c-primary);
    margin-bottom: 0.75rem;
}

.branch-unit-desc {
    font-size: 0.92rem;
    color: var(--c-text-muted);
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1.25rem;
}

.branch-details-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--c-text);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.branch-details-link:hover {
    color: var(--c-primary);
    gap: 0.6rem;
}

/* ==========================================================================
   CAMPAMENTOS & FOTOS (Limpio y Alegre)
   ========================================================================== */

.camps-banner {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    box-shadow: var(--shadow-card);
    margin-bottom: 3rem;
}

.camps-banner-body {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.camps-banner-img {
    height: 100%;
    min-height: 320px;
}

.camps-banner-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.photo-gallery-clean {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
}

.photo-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 220px;
    box-shadow: var(--shadow-subtle);
    position: relative;
}

.photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.photo-card:hover img {
    transform: scale(1.06);
}

.photo-tag-over {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    color: #FFFFFF;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
}

/* ==========================================================================
   PREGUNTAS FRECUENTES (FAQ PARA PADRES)
   ========================================================================== */

.faq-container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.faq-block {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
    box-shadow: var(--shadow-subtle);
}

.faq-block h4 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--c-text);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.faq-block p {
    font-size: 0.95rem;
    color: var(--c-text-muted);
    line-height: 1.6;
}

/* ==========================================================================
   SEDE & CONTACTO DIRECTO
   ========================================================================== */

.base-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 1rem;
}

.base-contact-box {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-card);
}

.contact-highlight-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.contact-icon-bubble {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--c-primary-light);
    color: var(--c-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.btn-whatsapp-direct {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: #25D366;
    color: #FFFFFF !important;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.95rem 1.5rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    margin-top: 1.25rem;
    transition: var(--transition);
}

.btn-whatsapp-direct:hover {
    background: #20BA5A;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
}

/* Formulario Limpio */
.form-row {
    margin-bottom: 1.2rem;
}

.form-row label {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.35rem;
}

.form-input {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid #CBD5E1;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.95rem;
    background: #FFFFFF;
    transition: var(--transition);
}

.form-input:focus {
    outline: none;
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px rgba(176, 35, 36, 0.12);
}

/* ==========================================================================
   FOOTER LIMPIO
   ========================================================================== */

.clean-footer {
    background: #0F172A;
    color: rgba(255, 255, 255, 0.85);
    padding: 70px 0 35px 0;
    border-top: 1px solid #1E293B;
}

.footer-main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
}

.footer-brand h4 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.footer-brand p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #94A3B8;
    max-width: 320px;
    margin-bottom: 1.25rem;
}

.footer-social-links {
    display: flex;
    gap: 0.65rem;
}

.footer-social-links a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    transition: var(--transition);
}

.footer-social-links a:hover {
    background: var(--c-primary);
    transform: translateY(-2px);
}

.footer-heading {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    margin-bottom: 1.2rem;
}

.footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
}

.footer-list a {
    color: #94A3B8;
    font-size: 0.9rem;
}

.footer-list a:hover {
    color: #FFFFFF;
    padding-left: 3px;
}

.footer-bottom-copy {
    border-top: 1px solid #1E293B;
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: #64748B;
}

/* ==========================================================================
   RESPONSIVO
   ========================================================================== */

@media (max-width: 900px) {
    .nav-menu { display: none; }
    .nav-menu.open {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 65px;
        left: 16px;
        right: 16px;
        background: #FFFFFF;
        border: 1px solid var(--c-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-card);
        padding: 1.5rem;
        gap: 0.8rem;
    }
    .mobile-menu-btn { display: flex; }
    .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
    }
    .hero-main-photo { height: 320px; }
    .camps-banner {
        grid-template-columns: 1fr;
    }
    .camps-banner-body { padding: 2rem; }
    .base-contact-grid {
        grid-template-columns: 1fr;
    }
    .footer-main-grid {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }
}

@media (max-width: 600px) {
    .hero-sunny { padding: 45px 0 60px 0; }
    .footer-main-grid { grid-template-columns: 1fr; }
    .hero-checks { flex-direction: column; gap: 0.5rem; }
}


/* ==========================================================================
   COMPATIBILIDAD CON SUBPÁGINAS (Nosotros, Secciones, Campamentos, Contacto)
   ========================================================================== */

.page-header {
    background: linear-gradient(180deg, #FFFDFB 0%, #F1F5F9 100%);
    padding: 60px 0 50px 0;
    text-align: center;
    border-bottom: 1px solid var(--c-border);
}

.page-header h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 900;
    color: var(--c-text);
}

.announcement-bar {
    background: #FFF1F2;
    border-bottom: 1px solid #FFE4E6;
    padding: 0.55rem 0;
    font-size: 0.88rem;
    color: #9F1239;
}

.announcement-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.announcement-link {
    font-weight: 700;
    color: var(--c-primary);
    text-decoration: underline;
}

/* Navbar de subpáginas */
.navbar {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-border);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 24px;
    max-width: 1200px;
    margin: 0 auto;
}

.nav-logo a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.2rem;
    color: var(--c-text);
}

.nav-logo img {
    height: 36px;
    width: auto;
}

.nav-cta {
    background: var(--c-primary) !important;
    color: #FFFFFF !important;
    padding: 0.55rem 1.25rem !important;
    border-radius: var(--radius-pill) !important;
    font-weight: 700 !important;
}

/* Botones genéricos */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.92rem;
    transition: var(--transition);
}

.btn-primary {
    background: var(--c-primary);
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(176, 35, 36, 0.25);
}

.btn-primary:hover {
    background: var(--c-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(176, 35, 36, 0.35);
}

.btn-secondary {
    background: #FFFFFF;
    color: var(--c-text) !important;
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-subtle);
}

.btn-secondary:hover {
    border-color: var(--c-primary);
    color: var(--c-primary) !important;
    transform: translateY(-2px);
}

/* Grillas para subpáginas */
.approach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}

.approach-item {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem 1.75rem;
    box-shadow: var(--shadow-subtle);
}

.approach-number {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--c-primary);
    margin-bottom: 0.5rem;
}

.team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    text-align: center;
}

.team-member {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1rem;
    box-shadow: var(--shadow-subtle);
    transition: var(--transition);
}

.team-member:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--c-primary-border);
}

.team-subtitle {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--c-text);
    margin-bottom: 1.25rem;
    text-align: center;
}

.footer {
    background: #0F172A;
    color: rgba(255, 255, 255, 0.85);
    padding: 60px 0 30px 0;
    border-top: 1px solid #1E293B;
}

.footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: 3rem;
    margin-bottom: 3rem;
}

.footer-logo-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
    color: #FFFFFF;
}

.footer-logo-header img {
    height: 32px;
}

.footer-description {
    font-size: 0.9rem;
    color: #94A3B8;
    line-height: 1.6;
}

.footer-social {
    display: flex;
    gap: 0.65rem;
    margin-top: 0.5rem;
}

.footer-social a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    transition: var(--transition);
}

.footer-social a:hover {
    background: var(--c-primary);
}

.footer-section h4 {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #FFFFFF;
    margin-bottom: 1.2rem;
}

.footer-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
}

.footer-section a {
    color: #94A3B8;
    font-size: 0.9rem;
}

.footer-section a:hover {
    color: #FFFFFF;
    padding-left: 3px;
}

.footer-contact-item {
    display: flex;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: #94A3B8;
    margin-bottom: 0.65rem;
}

.footer-bottom {
    border-top: 1px solid #1E293B;
    padding-top: 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: #64748B;
}

.footer-bottom-links {
    display: flex;
    gap: 1.5rem;
}

.footer-bottom-links a {
    color: #64748B;
}

/* Shop grid para objetos-perdidos */
.shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
}

.shop-item {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: var(--transition);
}

.shop-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--c-primary-border);
}

.shop-item-image {
    position: relative;
    height: 200px;
}

.shop-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.shop-item-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
}

.shop-item-badge-found {
    background: #DEF7EC;
    color: #03543F;
}

.shop-item-content {
    padding: 1.25rem;
}

.shop-item-content h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
}

.shop-item-content p {
    font-size: 0.88rem;
    color: var(--c-text-muted);
    margin-bottom: 0.5rem;
}

.shop-item-meta {
    font-size: 0.8rem;
    color: var(--c-primary);
    font-weight: 700;
}


/* ==========================================================================
   COMPONENTES INTERACTIVOS "WOW FACTOR" · ACRUX 518 2026
   ========================================================================== */

/* 1. HERO STATS & PHOTO STACK */
.hero-stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
}

.hero-stat-box {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    box-shadow: var(--shadow-subtle);
    transition: var(--transition);
}

.hero-stat-box:hover {
    transform: translateY(-3px);
    border-color: var(--c-primary);
    box-shadow: 0 8px 20px rgba(176, 35, 36, 0.1);
}

.hero-stat-num {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--c-primary);
    line-height: 1;
    display: block;
    margin-bottom: 0.25rem;
}

.hero-stat-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

/* Pañoleta Visual en Hero */
.scarf-visual-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #FFFFFF;
    border: 2px solid #FFE4E6;
    border-radius: var(--radius-md);
    padding: 0.85rem 1.25rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 6px 18px rgba(176, 35, 36, 0.08);
}

.scarf-triangle {
    width: 48px;
    height: 48px;
    position: relative;
    clip-path: polygon(50% 100%, 0 0, 100% 0);
    background: linear-gradient(90deg, #B02324 50%, #FFFFFF 50%);
    border: 2px solid #E2E8F0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
}

.scarf-text-title {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--c-text);
    display: block;
}

.scarf-text-sub {
    font-size: 0.82rem;
    color: var(--c-text-muted);
}

/* 2. SIMULADOR INTERACTIVO: FINDER DE SECCIONES */
.finder-section-wrapper {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--c-border);
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.07);
    padding: 2.5rem;
    margin-top: 2rem;
}

.finder-controls {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 2.5rem auto;
}

.finder-slider-box {
    margin: 1.5rem 0 1rem 0;
}

.finder-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 10px;
    border-radius: 5px;
    background: #E2E8F0;
    outline: none;
    cursor: pointer;
    transition: background 0.2s;
}

.finder-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c-primary);
    cursor: pointer;
    border: 3px solid #FFFFFF;
    box-shadow: 0 4px 12px rgba(176, 35, 36, 0.4);
    transition: transform 0.15s ease;
}

.finder-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
}

.finder-slider::-moz-range-thumb {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c-primary);
    cursor: pointer;
    border: 3px solid #FFFFFF;
    box-shadow: 0 4px 12px rgba(176, 35, 36, 0.4);
}

.age-display-bubble {
    display: inline-block;
    background: var(--c-primary);
    color: #FFFFFF;
    font-size: 1.3rem;
    font-weight: 800;
    padding: 0.35rem 1.4rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 12px rgba(176, 35, 36, 0.25);
    margin-bottom: 0.75rem;
}

.quick-age-btns {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
}

.quick-age-btn {
    background: #F1F5F9;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: var(--transition);
}

.quick-age-btn:hover, .quick-age-btn.active {
    background: var(--c-primary);
    color: #FFFFFF;
    border-color: var(--c-primary);
}

/* Tarjeta dinámica del Finder */
.finder-result-card {
    background: #FAFAFA;
    border-radius: var(--radius-md);
    border: 2px solid #E2E8F0;
    padding: 2rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: center;
    transition: all 0.3s ease;
}

@media (max-width: 860px) {
    .finder-result-card {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 1.5rem;
    }
}

.finder-avatar-icon {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    margin: 0 auto;
    flex-shrink: 0;
}

.finder-info-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--c-text);
    margin-bottom: 0.25rem;
}

.finder-motto-tag {
    display: inline-block;
    font-weight: 800;
    font-size: 0.88rem;
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.75rem;
}

.finder-features-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
    list-style: none;
}

.finder-features-list li {
    font-size: 0.88rem;
    color: var(--c-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

/* 3. SIMULADOR DE MOCHILA SCOUT (CHECKLIST INTERACTIVA) */
.backpack-section-card {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    padding: 2.5rem;
    margin-top: 2rem;
}

.backpack-type-nav {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
}

.backpack-type-btn {
    background: #F8FAFC;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    padding: 0.65rem 1.4rem;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.backpack-type-btn:hover, .backpack-type-btn.active {
    background: var(--c-primary);
    color: #FFFFFF;
    border-color: var(--c-primary);
    box-shadow: 0 4px 14px rgba(176, 35, 36, 0.25);
}

.backpack-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2.5rem;
    align-items: start;
}

@media (max-width: 900px) {
    .backpack-grid {
        grid-template-columns: 1fr;
    }
}

.gear-checklist {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
}

.gear-item {
    background: #F8FAFC;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    user-select: none;
    transition: var(--transition);
}

.gear-item:hover {
    background: #FFFFFF;
    border-color: #CBD5E1;
    transform: translateY(-2px);
}

.gear-item.packed {
    background: #F0FDF4;
    border-color: #86EFAC;
}

.gear-item.packed .gear-check {
    background: #16A34A;
    border-color: #16A34A;
    color: #FFFFFF;
}

.gear-item.packed .gear-title {
    text-decoration: line-through;
    color: #64748B;
}

.gear-check {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 2px solid #CBD5E1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 800;
    transition: var(--transition);
    flex-shrink: 0;
}

.gear-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--c-text);
}

.gear-tag {
    font-size: 0.75rem;
    color: var(--c-text-light);
    display: block;
}

/* Panel Lateral de Progreso de la Mochila */
.backpack-status-panel {
    background: linear-gradient(180deg, #FFFDFB 0%, #F8FAFC 100%);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    text-align: center;
}

.backpack-meter-circle {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    margin: 0 auto 1.25rem auto;
    background: #FFFFFF;
    border: 6px solid #E2E8F0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-subtle);
    position: relative;
    transition: border-color 0.4s ease;
}

.meter-pct {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--c-text);
    line-height: 1;
}

.meter-sub {
    font-size: 0.75rem;
    color: var(--c-text-muted);
    font-weight: 700;
}

.backpack-progress-bar-wrap {
    background: #E2E8F0;
    height: 10px;
    border-radius: var(--radius-pill);
    overflow: hidden;
    margin: 1rem 0;
}

.backpack-progress-bar-fill {
    background: var(--c-primary);
    height: 100%;
    width: 0%;
    transition: width 0.3s ease, background-color 0.3s ease;
}

.scouter-pro-tip {
    background: #FFFBEB;
    border-left: 4px solid #F59E0B;
    border-radius: 0 8px 8px 0;
    padding: 0.85rem 1rem;
    text-align: left;
    margin-top: 1.25rem;
    font-size: 0.84rem;
    color: #92400E;
    line-height: 1.5;
}

/* 4. TIMELINE DE UN DÍA EN EL CAMPAMENTO */
.camp-timeline-wrapper {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--c-border);
    padding: 2.5rem;
    margin-top: 2rem;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
}

.time-slots-container {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    scrollbar-width: thin;
}

.time-slot-pill {
    background: #F1F5F9;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    padding: 0.55rem 1.15rem;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--c-text-muted);
    white-space: nowrap;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
}

.time-slot-pill:hover, .time-slot-pill.active {
    background: var(--c-primary);
    color: #FFFFFF;
    border-color: var(--c-primary);
    box-shadow: 0 4px 12px rgba(176, 35, 36, 0.25);
}

.timeline-content-card {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2rem;
    align-items: center;
    background: #FFFDFB;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
}

@media (max-width: 800px) {
    .timeline-content-card {
        grid-template-columns: 1fr;
    }
}

.timeline-card-photo {
    width: 100%;
    height: 320px;
    object-fit: cover;
    display: block;
}

.timeline-card-body {
    padding: 2rem;
}

.timeline-hour-tag {
    display: inline-block;
    background: #FFE4E6;
    color: #9F1239;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.75rem;
}

.timeline-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--c-text);
    margin-bottom: 0.75rem;
}

.timeline-desc {
    color: var(--c-text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
}

.timeline-scout-quote {
    font-style: italic;
    font-size: 0.88rem;
    color: var(--c-primary);
    border-left: 3px solid var(--c-primary);
    padding-left: 0.85rem;
}

/* 5. ACORDEÓN MODERNO FAQ */
.accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 850px;
    margin: 2rem auto 0 auto;
}

.accordion-item {
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition);
}

.accordion-item:hover {
    border-color: #CBD5E1;
    box-shadow: var(--shadow-subtle);
}

.accordion-header {
    width: 100%;
    text-align: left;
    padding: 1.25rem 1.5rem;
    background: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--c-text);
    cursor: pointer;
    border: none;
}

.accordion-header span.icon {
    font-size: 1.2rem;
    transition: transform 0.3s ease;
    color: var(--c-primary);
    flex-shrink: 0;
    margin-left: 1rem;
}

.accordion-item.open .accordion-header span.icon {
    transform: rotate(180deg);
}

.accordion-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding: 0 1.5rem;
    color: var(--c-text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
}

.accordion-item.open .accordion-body {
    max-height: 350px;
    padding: 0 1.5rem 1.5rem 1.5rem;
}

/* 6. WHATSAPP FLOATING PILL */
.whatsapp-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    background: #25D366;
    color: #FFFFFF !important;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 800;
    font-size: 0.92rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.whatsapp-float:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.55);
    color: #FFFFFF !important;
}

.whatsapp-float-pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #FFFFFF;
    box-shadow: 0 0 0 rgba(255, 255, 255, 0.7);
    animation: pulse-dot 1.8s infinite;
}

@keyframes pulse-dot {
    0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(255, 255, 255, 0); }
    100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
}

/* 7. AMBIENT AUDIO TOGGLE IN CAMPFIRE */
.campfire-sound-pill {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1.15rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--c-text);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    box-shadow: var(--shadow-subtle);
    transition: var(--transition);
    margin-top: 1rem;
}

.campfire-sound-pill:hover {
    border-color: #F59E0B;
    background: #FFFBEB;
    color: #B45309;
}
